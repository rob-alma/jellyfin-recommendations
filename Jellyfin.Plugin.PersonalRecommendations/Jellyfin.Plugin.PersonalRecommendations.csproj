<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.PersonalRecommendations</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.PersonalRecommendations</AssemblyName>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <PackageId>Jellyfin.Plugin.PersonalRecommendations</PackageId>
    <Authors>robalma7</Authors>
    <Description>Personalized recommendations for Jellyfin based on each user's watch history.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="10.11.11">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jellyfin.Plugin.PersonalRecommendations.Core\Jellyfin.Plugin.PersonalRecommendations.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../meta.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
    <None Remove="Api\client.js" />
    <EmbeddedResource Include="Api\client.js" />
  </ItemGroup>

</Project>
